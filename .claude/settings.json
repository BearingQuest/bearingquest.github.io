{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh * pr merge)",
      "Bash(gh * pr merge *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git * push --force*)",
      "Bash(git * push -f*)",
      "Bash(git * push * --force*)",
      "Bash(git * push * -f*)",
      "Bash(git * push * +*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *actions/permissions*)",
      "Bash(gh api *code-security*)",
      "Bash(gh api *environments*)",
      "Bash(gh api *actions/secrets*)",
      "Bash(gh api *pages*)",
      "Bash(gh secret *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh release *)",
      "Bash(git tag *)",
      "Bash(git * tag)",
      "Bash(git * tag *)",
      "Bash(git push *--tags*)",
      "Bash(git * push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git * push *--follow-tags*)",
      "Read(~/.ai_post_env)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/career-workspace/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(//Library/Application Support/ClaudeCode/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(gh pr *)",
      "Bash(gh * pr)",
      "Bash(gh * pr *)",
      "Bash(gh api *)",
      "Bash(gh * api)",
      "Bash(gh * api *)",
      "Bash(python3 *)"
    ]
  }
}
